$*********************************************************************$
$---------------- Parallel processing control data -------------------$
PROCESSORS           1.0  (no. of processors to invoke)
MESSAGE MODE         1.0  (message passing strategy: 0=std, 1=buf)
$---------------- Geometric model type -------------------------------$
THREED                    (twod, axisym, threed)
$---------------- Grid file data -------------------------------------$
UNS GRID             1.0  (1=aflr3 format)
  ./my_example.b8.ugrid
GRID SCALING FACTOR  0.0254  (scale factor to convert grid to meters)
$---------------- Restart file data ----------------------------------$
RESTART IN
  Restart_files/restart
RESTART OUT      10000.0
  Restart_files/restart
WARNING MESSAGES     0.0  (0=off, 1=wf, 2=temp, 3=sub/sup, 4=real, 5=all)
$---------------- Output control data --------------------------------$
TECPLOT OUTPUT       1.0  (0=off, 1=.plt, 2=.szplt)
32 BIT BINARY             (write plot files as 32 or 64 bit binary)
PLOT FUNCTION       10.0  (no. of plot function names)
  DENSITY
  VELOCITY
  MACH NO.
  PRESSURE
  TEMPERATURE
  VISCOSITY
  EDDY VISCOSITY RATIO
  TKE
  TOTAL PRESSURE
  DT REDUCTION FACTOR
$---------------- Equation set data ----------------------------------$
GLOBAL VISCOUS            (solve N-S equations using global algorithm)
MAX. STATIC TEMP   450.0  (maximum allowable static temperature)
$---------------- Gas and thermodynamic data -------------------------$
GAS/THERMO MODEL     0.0  (0=CP, 1=TEQ, 2=TNE)
VISCOSITY MODEL      1.0  (0=Power, 1=Sutherland, 2=Suth/lin, 4=McBride)
CONDUCTIVITY MODEL   0.0  (0=Prandtl no., 1=Wassilej law)
$---------------- Reference condition data ---------------------------$
ANGLE REF. FRAME     1.0  (0=ALPHA in xy plane, 1=ALPHA in xz plane)
ALPHA               +1.5  (angle of attack measured C.C.W in degrees)
BETA                 0.0  (angle of yaw measured C.C.W in degrees)
MOMENT REF. X        0.0  (x coordinate of datum for moment integration)
MOMENT REF. Y        0.0  (y coordinate of datum for moment integration)
MOMENT REF. Z        0.0  (z coordinate of datum for moment integration)
NONDIM               1.0  (1=static conditions, 2=total conditions)
GAMMA                1.4
MACH NO.             4.0
GAS CONSTANT         287.04667
STATIC TEMPERATURE   64.722222
STATIC PRESSURE      1600.96
UNIT REYNOLDS NO.   -1.0
SUTHERLANDS LAW MU0  1.7160e-05
SUTHERLANDS LAW T0   2.7311e+02
SUTHERLANDS LAW S0   1.1056e+02
PRANDTL NO.          0.72
$-------------- Unstructured grid gradient options -------------------$
UNS CELL AVG GRADIENT METHOD   3.0  (0=GG, 1=LSFN1, 2=LSFN2, 3=LSNN)
UNS CELL AVG GRADIENT WEIGHTS  2.0  (-1->wt=-1.0, 1->wt=0.0, 2->wt=0.0,-1.0)
UNS CELL FACE GRADIENT METHOD  1.0  (0=EN, 1=FT, 2=HR)
$-------------- Unstructured grid robustness enhancement options -----$
UNS DDT INVISCID JACOBIAN      1.0  (0.0 or 1.0)
UNS TLNS VISCOUS JACOBIAN      1.0  (diag. dom. factor between 1.0 and 5.0)
ENABLE TIME STEP REDUCTION LOGIC
$---------------- Turbulence model data ------------------------------$
$ LAMINAR  SPALART  WILCOX-1998  WILCOX-2006  MENTER-BSL  MENTER-SST  $
TURBULENCE MODEL
  MENTER-SST-2003
VORTICITY-BASED PRODUCTION
TURB. INTENSITY      0.001
TURB. VISC. RATIO    0.010
TURB. PRANDTL NO.    0.90
$---------------- Boundary and cut control ---------------------------$
UNST BLOCKS          1.0  (no. of unstructured blocks)
BCGROUPS             9.0  (no. of boundary condition groups)
BCOBJECTS            2.0  (no. of boundary condition objects)
BLOCK CONFIG.        1.0  (no. of block configuration lines)
BLK  VISC (N, T, or F)  TURB  REAC  REGION
 0     F                  Y            1
