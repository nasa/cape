#!/usr/bin/env python3
r"""
``pqstat``: Display PBS statistics
========================================

:Call:

    .. code-block:: bash

        $ pqstat [OPTIONS]

:Options:
    
    -h, --help
        Display this help message and exit
        
    -u, --user UNAME
        Display information for *UNAME*, otherwise use the current user
        (Note: *UNAME* may include commas, which checks mulitple users)
        
    -q, --queue QUEUE
        Get stats for a specific queue

    -g, --group GROUP
        Get stats for a specific group (can be combined with *QUEUE* and
        *UNAME*)

    -m, --model MODEL
        Limit stats to a specific architecture/model

    -t, --total
        Only show grand total instead of individual groups/users/que

    --show-group
        Group statistics by group name

    --show-user
        Group statistics by user ID

    --no-show-model
        Don't group statistics by architecture

    --no-show-queue
        Don't group statistics by queue name
        
:Versions:
    * 2015-07-23 ``@ddalle``: Version 1.0
    * 2017-03-02 ``@ddalle``: Version 1.1; add ``-t``
    * 2021-09-01 ``@ddalle``: Version 1.2; add ``-g``
    * 2026-10-08 ``@ddalle``: Version 1.3; PBS Pro compatibility
"""

# Standard library modules
import getpass
import grp
import os
import re
import shutil
import subprocess as sp

# CAPE modules
from cape.argread import readkeys
from cape.textutils import markdown


# Primary function
def main(**kw):
    r"""Process and display queue statistics for a user

    :Call:
        >>> main(**kw)
    :Inputs:
        *h*, *help*: ``True`` | {``False``}
            Display help message and terminate
        *u*, *user*: {``None``} | :class:`str`
            Name of user to query (uses ``getpass.getuser()`` if all
            three options are blank) (can include multiple users
            separated by comma)
        *q*, *queue*: {``None``} | :class:`str`
            Specific queue; if ``None``, list all queues
        *g*, *group*: {``None``} | :class:`str`
            Name of group to query
        *m*, *model*: {``None``} | :class:`str`
            Only consider specific model(s)
        *t*, *total*: ``True`` | {``False``}
            Option to only show totals
        *show_model*, *show-model*: {``True``} | ``False``
            Group stats by architecture/model
        *show_group*, *show-group*: ``True`` | {``False``}
            Group stats by group name
        *show_queue*, *show-queue*: {``True``} | ``False``
            Group stats by queue name
        *show_user*, *show-user*: ``True`` | {``False``}
            Group stats by user name
    :Versions:
        * 2015-07-23 ``@ddalle``: Version 1.0
        * 2017-03-02 ``@ddalle``: Version 1.1; add ``-t``
        * 2021-09-01 ``@ddalle``: Version 1.2; add ``-g``
        * 2026-10-08 ``@ddalle``: v1.3; get group from ``group_list``,
          drop ``-e`` for recent ``nas_qstat``
    """
    # Check for help
    if kw.get("help", kw.get("h")):
        print(markdown(__doc__))
        return
    # Get user name
    u = kw.get("user", kw.get('u'))
    # Get queue name
    q = kw.get("queue", kw.get("que", kw.get('q')))
    # Get group
    g = kw.get("group", kw.get("g"))
    # Get model
    m = kw.get("model", kw.get("m"))
    # Formatting options
    show_model = kw.get("show-model", kw.get("show_model", True))
    show_group = kw.get("show-group", kw.get("show_group", False))
    show_queue = kw.get("show-queue", kw.get("show_queue", True))
    show_uname = kw.get("show-user", kw.get("show_user", False))
    # Interpret option for showing only total
    q_total = kw.get("total", kw.get("t", False))
    # Check for "-q" with no named queue
    if q is True:
        print("WARNING: option '-q' needs a queue name; ignoring")
        q = None
    if u is True:
        print("WARNING: option '-u' needs a value; using default")
        u = None
    if g is True:
        print("WARNING: option '-g' needs a value; ignoring")
        g = None
    if m is True:
        print("WARNING: option '-m' needs a value; ignoring")
        m = None
    # Default user
    if (q is None) and (u is None) and (g is None):
        # Use current user
        u = getpass.getuser()
    # Get list of users for group if needed
    if g and (u is None):
        # Get interface to group
        try:
            group = grp.getgrnam(g)
        except KeyError:
            print("ERROR: group '%s' not found; no stats to show" % g)
            return
        # Convert to user
        u = ",".join(group.gr_mem)
    # Select a command
    use_nas_qstat = bool(shutil.which("nas_qstat"))
    if use_nas_qstat:
        # Newer version
        cmd = ["nas_qstat", "-W", "o=+model", "-W", "o=+group"]
    else:
        # Initialize command
        cmd = ["qstat", "-W", "-o=+model", "-W", "-o=+group"]
    # Check for specific queue/user
    if u:
        cmd.extend(["-u", u])
    # Check for queue option
    if q and (not use_nas_qstat):
        # Current ``nas_qstat`` does not recognize ``-e``; for that
        # case the queue is screened out after reading the output
        cmd.extend(["-e", q])
    # List of users
    if u:
        users = u.split(",")
    else:
        users = []
    # List of models
    if m:
        models = m.split(",")
    else:
        models = []
    # Get qstat output
    try:
        lines = check_lines(cmd)
    except Exception:
        raise
    # Check for no jobs.
    if len(lines) < 3:
        return
    # Initialize stats.
    d = {}
    # Check for reasonable number of lines
    if len(lines) < 4:
        print("No jobs found.")
        return
    # Get the group name for each job
    if use_nas_qstat and (show_group or g):
        # The ``Group`` column of ``nas_qstat`` comes from the job
        # attribute ``egroup``, which recent PBS servers do not set.
        # The accounting group is in the ``group_list`` attribute,
        # which is only available in the full-format output.
        groups = get_groups([x.split()[0] for x in lines[3:-1] if x.split()])
    else:
        groups = {}
    # Loop through lines.
    for line in lines[3:-1]:
        # Separate out the properties for this script
        vals = line.split()
        # Get the user and queue name for this job
        qj = vals[2]
        # User name
        try:
            uj = vals[1]
        except Exception:
            uj = "unknown"
        # Model name
        try:
            nj, mj = vals[10].split(':')
        except Exception:
            nj, mj = 0, "unknown"
        # Group name
        gj = groups.get(job_key(vals[0]), None)
        if gj is None:
            try:
                gj = vals[11]
            except Exception:
                gj = "unknown"
        if gj in ("--", ""):
            gj = "unknown"
        # Check for a requested queue or group
        if q and (qj != q[:8]):
            continue
        if g and (gj != g):
            continue
        if u and (uj not in users):
            continue
        if m and (mj not in models):
            continue
        # Form a title
        titleparts = []
        if show_queue:
            titleparts.append("queue=%s" % qj)
        if show_uname:
            titleparts.append("user=%s" % uj)
        if show_model:
            titleparts.append("model=%s" % mj)
        if show_group:
            titleparts.append("group=%s" % gj)
        # Assemble title
        tj = ", ".join(titleparts)
        # Initialize the queue statistics if necessary.
        if tj not in d:
            d[tj] = {
                'R': {'jobs':0, 'nodes':0, 'cores':0, 'model':'', 'eff':0.0},
                'Q': {'jobs':0, 'nodes':0, 'cores':0, 'model':''}
            }
        # Number of nodes and cores
        nnj = int(vals[5])
        ncj = int(vals[4])
        # Add the job to the statistics.
        if vals[7] == 'R':
            # Running job.
            d[tj]['R']['jobs'] += 1
            # Current number of processed nodes and cores
            nci = d[tj]['R']['cores']
            # Current cumulative efficiency and current job efficency
            ei = d[tj]['R']['eff']
            try:
                ej = float(vals[9].rstrip('%'))
            except Exception:
                ej = 0.0
            # Nodes and cores
            d[tj]['R']['nodes'] += nnj
            d[tj]['R']['cores'] += ncj
            # Calculate efficiency
            d[tj]['R']['eff'] = (ei*nci + ej*ncj) / (nci+ncj)
            # Model name
            d[tj]['R']['model'] = mj
        elif vals[7] == 'Q':
            # Queued job.
            d[tj]['Q']['jobs'] += 1
            # Nodes and cores
            d[tj]['Q']['nodes'] += nnj
            d[tj]['Q']['cores'] += ncj
            # Model name
            d[tj]['R']['model'] = mj
    # Display the stats.
    show_qstats(d, q_total=q_total)


# Function to show queue statistics
def show_qstats(d, q_total=False):
    r"""Show queue statistics

    :Call:
        >>> show_qstats(d, q_total=False)
    :Inputs:
        *d*: :class:`dict`
            Dictionary of queue statistics
        *q_total*: ``True`` | {``False``}
            Option to only show totals
    :Versions:
        * 2015-07-23 ``@ddalle``: Version 1.0
        * 2017-06-23 ``@ddalle``: Version 1.1; add totals
    """
    # Initialize totals
    RT = {"jobs": 0, "nodes": 0, "cores": 0} 
    QT = {"jobs": 0, "nodes": 0, "cores": 0}
    # Loop through the queues.
    for q in d:
        # Extract running qnd queued statistics
        R = d[q]['R']
        Q = d[q]['Q']
        # Add to totals
        for k in ["jobs", "nodes", "cores"]:
            RT[k] += R[k]
            QT[k] += Q[k]
        # Check for option to hide totals
        if (not q_total):
            # Check for empty response
            # (can happen b/c of group members doing other work)
            if R["jobs"] + Q["jobs"] == 0:
                continue
            # Display the queue name.
            print("%s" % q)
            # Display the running jobs statistics
            print("  R: %3i jobs, %4i nodes, %5i cores, %.1f%% efficiency"
                % (R['jobs'], R['nodes'], R['cores'], R['eff']))
            # Display the queued jobs statistics
            print("  Q: %3i jobs, %4i nodes, %5i cores"
                % (Q['jobs'], Q['nodes'], Q['cores']))
            # Totals.
            print("  T: %3i jobs" % (R['jobs']+Q['jobs']))
    # Print totals
    print("TOTALS:")
    print("  R: %3i jobs, %4i nodes, %5i cores"
        % (RT['jobs'], RT['nodes'], RT['cores']))
    # Display the queued jobs statistics
    print("  Q: %3i jobs, %4i nodes, %5i cores"
        % (QT['jobs'], QT['nodes'], QT['cores']))
    # Totals.
    print("  T: %3i jobs" % (RT['jobs']+QT['jobs']))


# Function to extract a job key from a job ID
def job_key(job_id):
    r"""Extract the serial number (and array index) from a job ID

    :Call:
        >>> key = job_key(job_id)
    :Inputs:
        *job_id*: :class:`str`
            Job ID as reported by ``qstat`` or ``nas_qstat``
    :Outputs:
        *key*: :class:`str`
            Job serial number, including the array index if present
    """
    mo = re.match(r'-?\d+(?:\[\d+\])?', job_id)
    if mo:
        return mo.group(0)
    return job_id


# Function to get the accounting group of each job
def get_groups(job_ids, chunk=100):
    r"""Look up the accounting group of each job

    The ``Group`` column of ``nas_qstat`` reports the job attribute
    ``egroup``, which recent PBS servers no longer set. The accounting
    group is stored in the ``group_list`` resource, which is only
    visible in the full-format output.

    :Call:
        >>> groups = get_groups(job_ids)
    :Inputs:
        *job_ids*: :class:`list`\ [:class:`str`]
            Job IDs as reported by ``nas_qstat``
        *chunk*: :class:`int`
            Number of job IDs per ``nas_qstat`` call
    :Outputs:
        *groups*: :class:`dict`
            Accounting group of each job, ``groups[job_key]``
    """
    # Initialize the output
    groups = {}
    # Loop through chunks of job IDs
    for k0 in range(0, len(job_ids), chunk):
        # Form the command
        cmd = ["nas_qstat", "-f"] + job_ids[k0:k0+chunk]
        # Call the command (jobs can vanish, so do not require success)
        proc = sp.run(cmd, stdout=sp.PIPE, stderr=sp.DEVNULL)
        txt = proc.stdout.decode("utf-8", errors="replace")
        # Parse the full-format output
        key = None
        for line in txt.split("\n"):
            word = line.strip()
            # Check for the start of a new job
            mo = re.fullmatch(r'Job(?: Id)?:\s*(\S+)', word)
            if mo:
                key = job_key(mo.group(1))
                continue
            if key is None:
                continue
            # Check for a group attribute
            mo = re.fullmatch(r'(group_list|egroup)\s*=\s*(\S+)', word)
            if mo:
                if mo.group(1) == "group_list":
                    groups[key] = mo.group(2)
                elif key not in groups:
                    groups[key] = mo.group(2)
    # Output
    return groups


# Get lines from system call
def check_lines(cmd):
    r"""Capture STDOUT and split into list of lines

    :Call:
        >>> lines = check_lines(cmd)
    :Inputs:
        *cmd*: :class:`list`\ [:class:`str`]
            List of words of system command
    :Outputs:
        *lines*: :class:`list`\ [:class:`str`]
            List of lines in STDOUT (with \n stripped)
    :Versions:
        * 2021-09-01 ``@ddalle``: Version 1.0
    """
    # Call check_output()
    txt = sp.check_output(cmd)
    # Decode and split
    return txt.decode("utf-8").split("\n")


# Check for CLI call
if __name__ == "__main__":
    # Process inputs.
    a, kw = readkeys(os.sys.argv)
    # Call the main function
    main(**kw)

